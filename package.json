{
  "name": "crypto-sentiment",
  "version": "0.1.0",
  "private": true,
  "description": "A comprehensive cryptocurrency sentiment analysis platform with AI-powered insights",
  "author": "CryptoSentiment Team",
  "license": "MIT",
  "keywords": [
    "cryptocurrency",
    "sentiment analysis",
    "AI",
    "trading",
    "crypto",
    "blockchain"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:bots": "npx tsx src/scripts/bot-testing.ts",
    "test:bots:status": "npx tsx src/scripts/bot-testing.ts status",
    "test:bots:alert": "npx tsx src/scripts/bot-testing.ts alert",
    "test:bots:verify": "npx tsx src/scripts/bot-testing.ts verify",
    "test:bots:comprehensive": "npx tsx src/scripts/bot-testing.ts comprehensive",
    "populate-history": "npx tsx src/scripts/populate-historical-prices.ts",
    "postinstall": "prisma generate",
    "docker:build": "docker build -t cryptosentiment .",
    "docker:run": "docker run -p 3000:3000 cryptosentiment",
    "docker:compose": "docker-compose up --build",
    "deploy:railway": "railway up",
    "deploy:railway:auto": "./scripts/deploy-railway.sh",
    "prod:setup": "npm ci && npx prisma generate && npx prisma migrate deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.17.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@react-email/render": "^1.4.0",
    "@stripe/stripe-js": "^8.0.0",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/next": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/node-telegram-bot-api": "^0.64.11",
    "@types/nodemailer": "^7.0.2",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "discord.js": "^14.23.2",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.545.0",
    "next": "15.5.4",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "node-telegram-bot-api": "^0.66.0",
    "nodemailer": "^6.10.1",
    "postcss": "^8.5.6",
    "prisma": "^6.17.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.64.0",
    "resend": "^6.2.0",
    "sonner": "^2.0.7",
    "stripe": "^19.1.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.21",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
