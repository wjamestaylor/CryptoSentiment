# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cryptosentiment"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# API Keys
OPENROUTER_API_KEY="your-openrouter-api-key"
WHALEALERT_API_KEY="your-whalealert-api-key"
NEWSDATA_API_KEY="your-newsdata-api-key"
COINGECKO_API_KEY="your-coingecko-api-key"
COINMARKETCAP_API_KEY="your-coinmarketcap-api-key"

# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Products and Price IDs
STRIPE_PRO_PRODUCT_ID="prod_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_YEARLY_PRICE_ID="price_..."
STRIPE_BUSINESS_PRODUCT_ID="prod_..."
STRIPE_BUSINESS_MONTHLY_PRICE_ID="price_..."
STRIPE_BUSINESS_YEARLY_PRICE_ID="price_..."

# Redis (for caching and rate limiting)
REDIS_URL="redis://localhost:6379"

# Email (for notifications)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@cryptosentiment.com"

# Social Media Bots
DISCORD_BOT_TOKEN="your-discord-bot-token"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TWITTER_API_KEY="your-twitter-api-key"
TWITTER_API_SECRET="your-twitter-api-secret"

# Monitoring
SENTRY_DSN="your-sentry-dsn"

# Development
NODE_ENV="development"
LOG_LEVEL="debug"