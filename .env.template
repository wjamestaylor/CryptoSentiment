# =============================================================================
# CryptoSentiment Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local or any file containing real API keys to version control

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database URL for Prisma
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL="postgresql://username:password@localhost:5432/cryptosentiment"

# =============================================================================
# NEXTAUTH.JS CONFIGURATION
# =============================================================================
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# AI & SENTIMENT ANALYSIS
# =============================================================================
# OpenRouter API for AI-powered sentiment analysis
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# =============================================================================
# CRYPTOCURRENCY DATA APIS
# =============================================================================
# CoinGecko API (free tier available)
COINGECKO_API_KEY="CG-your-coingecko-api-key"
COINGECKO_BASE_URL="https://api.coingecko.com/api/v3"

# CoinMarketCap API (alternative/backup)
COINMARKETCAP_API_KEY="your-coinmarketcap-api-key"
COINMARKETCAP_BASE_URL="https://pro-api.coinmarketcap.com/v1"

# =============================================================================
# WHALE ACTIVITY MONITORING
# =============================================================================
# WhaleAlert API for tracking large transactions
WHALEALERT_API_KEY="your-whalealert-api-key"
WHALEALERT_BASE_URL="https://api.whale-alert.io/v1"

# =============================================================================
# NEWS & SOCIAL SENTIMENT
# =============================================================================
# NewsData.io API for crypto news sentiment
NEWSDATA_API_KEY="pub_your-newsdata-api-key"
NEWSDATA_BASE_URL="https://newsdata.io/api/1"

# =============================================================================
# PAYMENT PROCESSING
# =============================================================================
# Stripe for subscription billing
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# Stripe product/price IDs
STRIPE_BASIC_PRICE_ID="price_basic_tier_id"
STRIPE_PRO_PRICE_ID="price_pro_tier_id"
STRIPE_ENTERPRISE_PRICE_ID="price_enterprise_tier_id"

# =============================================================================
# CACHING & SESSION STORAGE
# =============================================================================
# Redis for caching and session storage
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="your-redis-password"

# =============================================================================
# NOTIFICATION SERVICES
# =============================================================================
# Email notifications (using Resend)
RESEND_API_KEY="re_your-resend-api-key"
FROM_EMAIL="noreply@cryptosentiment.com"

# Discord Bot for notifications
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_CLIENT_ID="your-discord-client-id"

# Telegram Bot for notifications
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Push notifications (Web Push)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Sentry for error tracking
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="cryptosentiment"

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT secrets (generate unique values)
JWT_SECRET="your-jwt-secret-for-api-tokens"
ENCRYPTION_KEY="your-32-character-encryption-key"

# Rate limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_SOCIAL_LOGIN="true"
ENABLE_WEBHOOK_NOTIFICATIONS="true"
ENABLE_REAL_TIME_UPDATES="true"
ENABLE_AI_SENTIMENT="true"
ENABLE_WHALE_ALERTS="true"

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Set to 'development' for local dev, 'production' for live
NODE_ENV="development"

# Enable debug logging
DEBUG="cryptosentiment:*"

# Mock external APIs for development
MOCK_EXTERNAL_APIS="false"

# GitHub Personal Access Token for MCP integration
GITHUB_PERSONAL_ACCESS_TOKEN="ghp_your-github-personal-access-token"

# =============================================================================
# DEPLOYMENT CONFIGURATION (Railway)
# =============================================================================
# Railway deployment settings
RAILWAY_STATIC_URL="https://your-app.railway.app"
RAILWAY_GIT_COMMIT_SHA="auto-populated-by-railway"

# =============================================================================
# WEBHOOK ENDPOINTS
# =============================================================================
# External webhook URLs for services to call
WEBHOOK_BASE_URL="https://your-domain.com/api/webhooks"
STRIPE_WEBHOOK_URL="${WEBHOOK_BASE_URL}/stripe"
WHALEALERT_WEBHOOK_URL="${WEBHOOK_BASE_URL}/whalealert"