// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  username      String?   @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Bot integration fields
  discordUserId    String?  @unique
  discordVerified  Boolean  @default(false)
  telegramUserId   String?  @unique
  telegramVerified Boolean  @default(false)

  // Subscription information
  subscription   Subscription?
  subscriptionId String?

  // User preferences
  preferences UserPreferences?

  // Followed cryptocurrencies
  followedCoins FollowedCoin[]

  // Unified crypto tracking (replaces both followedCoins and portfolioHoldings)
  cryptoTracking CryptoTracking[]

  // User alerts and notifications
  alerts        Alert[]
  notifications Notification[]
  usageLogs     UsageLog[]

  // Portfolio holdings
  portfolioHoldings PortfolioHolding[]

  // User sessions
  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  tier      SubscriptionTier
  status    SubscriptionStatus
  stripeId  String?  @unique
  
  // Stripe integration fields
  stripeSubscriptionId String? @unique
  stripeCustomerId     String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean @default(false)
  trialEnd             DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Notification settings
  emailNotifications     Boolean @default(true)
  pushNotifications      Boolean @default(true)
  discordNotifications   Boolean @default(false)
  telegramNotifications  Boolean @default(false)

  // Alert settings
  sentimentThreshold Float   @default(0.7)
  priceChangeThreshold Float @default(0.1)
  volumeThreshold    Float   @default(0.5)

  // UI preferences
  theme              String  @default("dark")
  currency           String  @default("USD")
  timezone           String  @default("UTC")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Cryptocurrency {
  id          String  @id @default(cuid())
  symbol      String  @unique
  name        String
  coinGeckoId String? @unique // CoinGecko API ID (e.g., "monero", "bitcoin")
  logoUrl     String?
  marketCap   Float?
  rank        Int?

  // Relationships
  followedBy        FollowedCoin[]
  portfolioHoldings PortfolioHolding[]
  cryptoTracking    CryptoTracking[]
  alerts            Alert[]
  sentimentData     SentimentAnalysis[]
  priceData         PriceData[]

  @@map("cryptocurrencies")
}

model CryptoTracking {
  id       String @id @default(cuid())
  userId   String
  cryptoId String

  // Tracking settings
  isWatching Boolean @default(true)  // Always true - everyone tracks
  
  // Portfolio holdings (optional - null means watching only)
  holdingAmount        Float?    // Amount owned (null = watching only)
  averagePurchasePrice Float?    // Average cost basis
  totalInvested        Float?    // Total USD invested
  firstPurchaseDate    DateTime? // When first purchased
  
  // Tracking metadata
  addedAt     DateTime @default(now())
  notes       String?
  tags        String[] // ["DeFi", "Research", "Long-term"]
  
  // Performance tracking
  lastViewedAt DateTime @default(now())
  priceAlerts  Json[]   // Alert configurations
  
  // Migration tracking
  migratedFromFollowed Boolean @default(false)
  migratedFromHolding  Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  crypto Cryptocurrency @relation(fields: [cryptoId], references: [id], onDelete: Cascade)

  @@unique([userId, cryptoId])
  @@map("crypto_tracking")
}

model FollowedCoin {
  id     String @id @default(cuid())
  userId String
  cryptoId String

  // Migration support
  migratedToCryptoTracking Boolean @default(false)

  createdAt DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  crypto Cryptocurrency @relation(fields: [cryptoId], references: [id], onDelete: Cascade)

  @@unique([userId, cryptoId])
  @@map("followed_coins")
}

model SentimentAnalysis {
  id       String @id @default(cuid())
  cryptoId String
  
  // Sentiment data
  score    Float
  label    SentimentLabel
  confidence Float

  // Source information
  sources  NewsSource[]
  whaleActivity WhaleActivity[]

  // AI analysis
  aiSummary   String
  aiReasoning String
  modelUsed   String

  createdAt DateTime @default(now())

  crypto Cryptocurrency @relation(fields: [cryptoId], references: [id])

  @@map("sentiment_analysis")
}

model NewsSource {
  id          String @id @default(cuid())
  title       String
  content     String
  url         String
  publishedAt DateTime
  source      String
  relevanceScore Float

  sentimentAnalysisId String
  sentimentAnalysis   SentimentAnalysis @relation(fields: [sentimentAnalysisId], references: [id])

  @@map("news_sources")
}

model WhaleActivity {
  id        String @id @default(cuid())
  amount    Float
  fromAddr  String?
  toAddr    String?
  txHash    String  @unique
  timestamp DateTime

  sentimentAnalysisId String
  sentimentAnalysis   SentimentAnalysis @relation(fields: [sentimentAnalysisId], references: [id])

  @@map("whale_activity")
}

model PriceData {
  id        String @id @default(cuid())
  cryptoId  String
  price     Float
  volume24h Float
  change24h Float
  marketCap Float
  timestamp DateTime @default(now())

  crypto Cryptocurrency @relation(fields: [cryptoId], references: [id])

  @@unique([cryptoId, timestamp], name: "cryptoId_timestamp")
  @@index([cryptoId, timestamp])
  @@map("price_data")
}

model Alert {
  id       String    @id @default(cuid())
  userId   String
  cryptoId String
  type     AlertType
  
  // Alert configuration
  condition String // JSON string with alert conditions
  isActive  Boolean @default(true)
  
  // Trigger information
  lastTriggered DateTime?
  triggerCount  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  crypto Cryptocurrency @relation(fields: [cryptoId], references: [id])

  @@map("alerts")
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  title   String
  content String
  isRead  Boolean          @default(false)

  // Optional alert reference
  alertId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  permissions String[] // Array of allowed endpoints
  isActive    Boolean  @default(true)
  
  // Usage tracking
  requestCount    Int      @default(0)
  lastUsed        DateTime?
  rateLimitTier   String   @default("basic")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("api_keys")
}

model UsageLog {
  id       String    @id @default(cuid())
  userId   String
  type     UsageType
  resource String    // e.g., "alert", "ai_analysis", "watchlist"
  metadata String?   // Additional data as JSON

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_logs")
}

enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
}

enum SentimentLabel {
  VERY_BULLISH
  BULLISH
  NEUTRAL
  BEARISH
  VERY_BEARISH
}

enum AlertType {
  SENTIMENT_CHANGE
  PRICE_CHANGE
  VOLUME_SPIKE
  WHALE_ACTIVITY
  NEWS_MENTION
}

enum NotificationType {
  ALERT_TRIGGERED
  SUBSCRIPTION_UPDATE
  SYSTEM_ANNOUNCEMENT
  SECURITY_NOTICE
}

enum UsageType {
  ALERT_CREATION
  AI_ANALYSIS
  WATCHLIST_ADD
  BOT_NOTIFICATION
}

model PortfolioHolding {
  id       String @id @default(cuid())
  userId   String
  cryptoId String

  // Holding details
  amount      Float    // Amount of cryptocurrency owned
  purchasePrice Float? // Price when purchased (in USD)
  purchaseDate  DateTime? // When the holding was added/purchased
  notes        String?  // Optional notes about the purchase

  // Migration support
  migratedToCryptoTracking Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  crypto Cryptocurrency @relation(fields: [cryptoId], references: [id], onDelete: Cascade)

  @@unique([userId, cryptoId])
  @@map("portfolio_holdings")
}